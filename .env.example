# Copy this file to .env and fill in your key. .env is git-ignored.
#
# Free key: https://console.groq.com/keys
# Without a key the app still diagnoses leaves; the AI assistant is hidden.
GROQ_API_KEY=

# Models (optional). Groq retires models regularly - if the server logs
# "model no longer exists", pick a current one from https://console.groq.com/docs/models
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# AI requests allowed per visitor per minute. Protects your Groq quota when
# the app is on a public Cloudflare URL.
AI_RATE_LIMIT_PER_MIN=20
